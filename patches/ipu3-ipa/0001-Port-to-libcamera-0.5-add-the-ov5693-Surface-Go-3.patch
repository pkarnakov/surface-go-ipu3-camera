-  cc.find_library('libia_mkn'),
-  cc.find_library('libia_log'),
-  cc.find_library('libSkyCamAICKBL'),
+  cc.find_library('ia_aiq'),
+  cc.find_library('ia_exc'),
+  cc.find_library('ia_coordinate'),
+  cc.find_library('ia_nvm'),
+  cc.find_library('ia_cmc_parser'),
+  cc.find_library('ia_mkn'),
+  cc.find_library('ia_log'),
+  cc.find_library('SkyCamAICKBL'),
 ]
 
 ia_imaging_dep = declare_dependency(
@@ -105,4 +105,8 @@ mod = shared_module(ipa_name,
                     include_directories : ipa_includes,
                     dependencies : ipu3_ipa_deps,
                     install : true,
-                    install_dir : ipa_install_dir)
+                    install_dir : ipa_install_dir,
+                    install_rpath : '$ORIGIN/lib',
+                    # DT_RPATH, not RUNPATH: it also covers the Intel
+                    # libraries' own dependencies (libia_exc, libc++)
+                    link_args : '-Wl,--disable-new-dtags')
