#!/bin/bash
# For pam_exec, before a face-login module (Howdy): start the IR feed and
# return once it delivers frames (surface-ir.service is Type=notify). Always
# succeeds, so a missing feed only makes face login fail, not the password.
# The poke file counts as a reader for 10 s, so a feed that is about to idle
# out stays until the face-login module has opened the device.
#   auth optional pam_exec.so quiet seteuid @LIBEXEC@/pam-start
# Needs root (seteuid). Undo: remove that line from the PAM service.
set -euo pipefail
PATH=/usr/sbin:/usr/bin
touch /run/surface-ir.poke || true
timeout 15 systemctl start surface-ir.service >/dev/null 2>&1 || true
